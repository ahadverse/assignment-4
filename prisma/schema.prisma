generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Condition {
  NEW
  GOOD
  FAIR
}

enum RentalStatus {
  PLACED
  CONFIRMED
  CANCELLED
  PAID
  PICKED_UP
  RETURNED
}

enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
}

enum PaymentMethod {
  CARD
  CASHAPP
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  password       String
  fullName       String
  phone          String
  role           Role       @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  profilePicture String?
  address        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  gearItems      GearItem[]    @relation("ProviderGear")
  customerOrders RentalOrder[] @relation("CustomerOrders")
  providerOrders RentalOrder[] @relation("ProviderOrders")
  payments       Payment[]
  reviews        Review[]

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  gearItems   GearItem[]

  @@map("categories")
}

model GearItem {
  id             String    @id @default(uuid())
  providerId     String
  categoryId     String
  name           String
  description    String
  brand          String
  pricePerDay    Decimal   @db.Decimal(10, 2)
  condition      Condition @default(GOOD)
  specifications Json?
  stock          Int       @default(0)
  availability   Boolean   @default(true)
  images         String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  provider     User          @relation("ProviderGear", fields: [providerId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  rentalOrders RentalOrder[]
  reviews      Review[]

  @@index([providerId])
  @@index([categoryId])
  @@map("gear_items")
}

model RentalOrder {
  id              String       @id @default(uuid())
  customerId      String
  gearId          String
  providerId      String
  rentalStartDate DateTime
  rentalEndDate   DateTime
  quantity        Int          @default(1)
  totalAmount     Decimal      @db.Decimal(10, 2)
  status          RentalStatus @default(PLACED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer User     @relation("CustomerOrders", fields: [customerId], references: [id])
  provider User     @relation("ProviderOrders", fields: [providerId], references: [id])
  gear     GearItem @relation(fields: [gearId], references: [id])
  payment  Payment?
  review   Review?

  @@index([customerId])
  @@index([providerId])
  @@index([gearId])
  @@map("rental_orders")
}

model Payment {
  id            String          @id @default(uuid())
  rentalOrderId String          @unique
  customerId    String
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("usd")
  provider      PaymentProvider @default(STRIPE)
  method        PaymentMethod?
  transactionId String?         @unique
  status        PaymentStatus   @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id])
  customer    User        @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("payments")
}

model Review {
  id            String   @id @default(uuid())
  gearId        String
  customerId    String
  rentalOrderId String   @unique
  rating        Int
  reviewText    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gear        GearItem    @relation(fields: [gearId], references: [id])
  customer    User        @relation(fields: [customerId], references: [id])
  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id])

  @@index([gearId])
  @@index([customerId])
  @@map("reviews")
}
