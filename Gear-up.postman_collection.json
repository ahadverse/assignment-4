{
  "info": {
    "_postman_id": "b7a4-gearup-collection-0001",
    "name": "GearUp API",
    "description": "Full collection for the GearUp gear rental API. Set {{baseUrl}} (local or your Render URL). Log in and paste the returned token into {{token}} (or the role-specific variable) manually before calling protected endpoints — there are no auto-chaining test scripts in this collection. Endpoint titles are suffixed with the required role where the endpoint is protected; unsuffixed endpoints are public. ADMIN can access every endpoint regardless of the suffix shown.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
