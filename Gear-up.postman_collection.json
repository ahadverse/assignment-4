        {
          "name": "Stripe Webhook (real event only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "webhook"
              ]
            },
            "description": "Requires a valid Stripe-Signature header, so it can't be triggered manually from Postman. Use the Stripe CLI (`stripe listen --forward-to <baseUrl>/payments/webhook`) to deliver real signed events, or use the Confirm Payment request above to finalize manually.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_manual\",\n      \"metadata\": {\n        \"rentalOrderId\": \"{{rentalOrderId}}\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
